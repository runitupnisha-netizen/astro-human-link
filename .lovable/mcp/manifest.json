{
  "version": 1,
  "sdk_version": "0.20.0",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://wquzijmkiotkupygoxdf.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "stellara-mcp",
      "version": "0.1.0",
      "title": "Stellara"
    },
    "tools": [
      {
        "name": "get_my_blueprint",
        "title": "Get my cosmic blueprint",
        "description": "Return the signed-in Stellara user's cosmic blueprint: astrology placements (sun/moon/rising/venus/mars/mercury), Human Design (type/authority/profile), and numerology (life path, personal year).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "get_today_briefing",
        "title": "Get today's cosmic briefing",
        "description": "Return the signed-in user's most recent daily cosmic briefing from Stellara: energy theme, focus, mood, affirmation, cosmic weather, lucky window, and journal prompt.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_shadow_journal_entries",
        "title": "List shadow journal entries",
        "description": "List the signed-in user's most recent Stellara shadow journal entries (prompt + entry text, newest first).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "limit": {
              "description": "Max entries to return (default 10).",
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "create_shadow_journal_entry",
        "title": "Create a shadow journal entry",
        "description": "Save a new shadow journal entry (prompt + reflection) for the signed-in user in Stellara.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "prompt": {
              "type": "string",
              "minLength": 1,
              "description": "The shadow work prompt being reflected on."
            },
            "entry": {
              "type": "string",
              "minLength": 1,
              "description": "The user's written reflection."
            }
          },
          "required": [
            "prompt",
            "entry"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "list_moon_journal_entries",
        "title": "List moon journal entries",
        "description": "List the signed-in user's most recent Stellara moon journal entries (phase, entry_type, content, newest first).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "limit": {
              "description": "Max entries to return (default 10).",
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "create_moon_journal_entry",
        "title": "Create a moon journal entry",
        "description": "Save a new moon journal entry (moon phase, entry type, and content) for the signed-in Stellara user.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "phase": {
              "type": "string",
              "minLength": 1,
              "description": "Moon phase, e.g. 'New Moon', 'Waxing Crescent', 'Full Moon'."
            },
            "entry_type": {
              "type": "string",
              "minLength": 1,
              "description": "Type of entry, e.g. 'intention', 'release', 'gratitude', 'reflection'."
            },
            "content": {
              "type": "string",
              "minLength": 1,
              "description": "The entry content."
            }
          },
          "required": [
            "phase",
            "entry_type",
            "content"
          ]
        },
        "outputSchema": null
      }
    ]
  }
}
